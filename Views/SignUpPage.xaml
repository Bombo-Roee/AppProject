<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:AppProject.ViewModels"
             x:Class="AppProject.Views.SignUpPage"
             x:DataType="viewmodels:SignUpViewModel"
             Title="SignUpPage">

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Wheat" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#004FF9" />
            <GradientStop Offset="1.0" Color="#FFF94C" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto"
              ColumnDefinitions="*,8*,*"
              Padding="10,30,10,30">

            <HorizontalStackLayout Grid.Column="1"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,0,0,20">
                <!-- כותרת -->
                <Label TextColor="White"
                       Text="Create Account"
                       FontSize="24"
                       FontAttributes="Bold" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 Grid.Column="1"
                                 Spacing="10">

                <!-- שדה שם פרטי -->
                <Border Padding="10"
                        Stroke="#ccc"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                    <Entry FontSize="18"
                           Placeholder="First Name"
                           PlaceholderColor="#888"
                           TextColor="Wheat"
                           Text="{Binding FirstName}" />
                </Border>

                <!-- שדה שם משפחה -->
                <Border Padding="10"
                        Stroke="#ccc"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                    <Entry FontSize="18"
                           Placeholder="Last Name"
                           PlaceholderColor="#888"
                           TextColor="Wheat"
                           Text="{Binding LastName}" />
                </Border>

                <!-- שדה דואל עם ולידציה של CommunityToolkit -->
                <Border Padding="10"
                        Stroke="#ccc"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                    <Entry Keyboard="Email"
                           FontSize="18"
                           Placeholder="Email"
                           PlaceholderColor="#888"
                           TextColor="Wheat"
                           Text="{Binding UserEmail}">
                        <Entry.Behaviors>
                            <toolkit:EmailValidationBehavior InvalidStyle="{StaticResource InvalidEntryStyle}"
                                                            ValidStyle="{StaticResource ValidEntryStyle}"
                                                            Flags="ValidateOnValueChanged" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>

                <!-- שדה סיסמה -->
                <Border Padding="10"
                        Stroke="#ccc"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                    <Grid Padding="0"
                          ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <Entry x:Name="PasswordEntry"
                               Grid.Column="0"
                               IsPassword="{Binding EntryAsPassword}"
                               BackgroundColor="Transparent"
                               FontSize="18"
                               Placeholder="Password"
                               PlaceholderColor="#888"
                               TextColor="Wheat"
                               VerticalOptions="Center"
                               Text="{Binding UserPassword}" />

                        <Button Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="0"
                                BackgroundColor="Transparent"
                                FontSize="24"
                                HorizontalOptions="End"
                                TextColor="White"
                                VerticalOptions="Center"
                                FontFamily="MaterialSymbolsFont"
                                Text="{Binding PasswordIconCode}"
                                Command="{Binding ShowPasswordCommand}" />
                    </Grid>
                </Border>

                <!-- שדה מספר נייד -->
                <Border Padding="10"
                        Stroke="#ccc"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                    <Entry Keyboard="Telephone"
                           FontSize="18"
                           Placeholder="Mobile (10 digits)"
                           PlaceholderColor="#888"
                           TextColor="Wheat"
                           Text="{Binding Mobile}" />
                </Border>

                <!-- כפתור הרשמה -->
                <Button CornerRadius="8"
                        FontSize="20"
                        HeightRequest="60"
                        Text="Sign Up"
                        TextColor="White"
                        Margin="0,15,0,0"
                        Command="{Binding SignUpCommand}" />

                <!-- Already have an account? SignIn -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="0,15,0,0">
                    <Label VerticalTextAlignment="Center"
                           TextColor="White"
                           Text="Already have an account?"
                           FontSize="16" />
                    <Button BackgroundColor="Transparent"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="BlueViolet"
                            Text="SignIn"
                            Command="{Binding NavigateToSignInCommand}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
