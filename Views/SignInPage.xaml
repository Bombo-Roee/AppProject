<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AppProject.Views"
             x:Class="AppProject.Views.SignInPage"
             x:DataType="views:SignInPage"
             Title="SignIn">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#2A134D" />
            <GradientStop Offset="0.5" Color="#1B173B" />
            <GradientStop Offset="1.0" Color="#100C24" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="20"
                             VerticalOptions="Center"
                             MaximumWidthRequest="400">

            <!-- כותרת כניסה לפי הדוגמה -->
            <Label Text="כניסה"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Start"
                   Margin="0,0,0,5" />

            <!-- EMAIL של שדה -->
            <Border Padding="10"
                    Stroke="#6B6B8A"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    BackgroundColor="Transparent">
                <Entry x:Name="UsernameEntry"
                       Keyboard="Email"
                       FontSize="18"
                       Placeholder="Email"
                       PlaceholderColor="#8888A0"
                       TextColor="Wheat"
                       ReturnType="Next"
                       Text="{Binding UserName}" />
            </Border>

            <!-- שדה של סיסמה עם כפתור TogglePassword -->
            <Border Padding="10"
                    Stroke="#6B6B8A"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    BackgroundColor="Transparent">
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           BackgroundColor="Transparent"
                           FontSize="18"
                           IsPassword="{Binding EntryAsPassword}"
                           Placeholder="סיסמה"
                           PlaceholderColor="#8888A0"
                           TextColor="Wheat"
                           VerticalOptions="Center"
                           Text="{Binding UserPassword}" />

                    <Button x:Name="TogglePassordButton"
                            Grid.Column="1"
                            Clicked="TogglePassordButtonClicked"
                            Margin="5,0,0,0"
                            Padding="0"
                            BackgroundColor="Transparent"
                            FontSize="24"
                            HorizontalOptions="End"
                            FontFamily="MaterialIcons"
                            TextColor="White"
                            VerticalOptions="Center"
                            Text="{Binding PasswordIconCode}" />
                </Grid>
            </Border>

            <!-- כפתור כניסה (SignIn) - מתחיל Disable והופך ל-Enable כששני השדות לא ריקים -->
            <Button CornerRadius="8"
                    FontSize="18"
                    HeightRequest="50"
                    Text="SignIn"
                    TextColor="White"
                    IsEnabled="{Binding IsSignInButtonEnabled}"
                    Clicked="OnSignInButtonClick"
                    Margin="0,10,0,0" />

            <!-- הודעת התחברות / שגיאת התחברות -->
            <Label x:Name="messageLabel"
                   FontSize="30"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding SignInMessageVisible}"
                   Text="{Binding LoginMessage}"
                   TextColor="{Binding SignInMessageColor}"
                   Margin="0,15,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
