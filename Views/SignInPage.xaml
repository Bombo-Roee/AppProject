<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AppProject.Views"
             x:Class="AppProject.Views.SignInPage"
             x:DataType="views:SignInPage"
             Title="SignIn">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="LightCyan" />
            <GradientStop Offset="0.5" Color="#3a7bd5" />
            <GradientStop Offset="1.0" Color="Purple" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="25"
                             VerticalOptions="Center"
                             MaximumWidthRequest="450">

            <!-- EMAIL של שדה -->
            <Border Padding="10"
                    Stroke="#ccc"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                <Entry x:Name="UsernameEntry"
                       Keyboard="Email"
                       FontSize="18"
                       Placeholder="Email"
                       PlaceholderColor="#444"
                       TextColor="Wheat"
                       ReturnType="Go"
                       Text="{Binding UserName}" />
            </Border>

            <!-- שדה של סיסמא -->
            <Border Padding="10"
                    Stroke="#ccc"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                <Grid Padding="0"
                      ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           BackgroundColor="Transparent"
                           FontSize="18"
                           IsPassword="{Binding EntryAsPassword}"
                           Placeholder="סיסמה"
                           PlaceholderColor="#444"
                           TextColor="Wheat"
                           VerticalOptions="Center"
                           Text="{Binding UserPassword}" />

                    <Button x:Name="TogglePassordButton"
                            Grid.Column="1"
                            Clicked="TogglePassordButtonClicked"
                            Margin="5,0,0,0"
                            Padding="0"
                            BackgroundColor="Transparent"
                            FontSize="24"
                            HorizontalOptions="End"
                            FontFamily="MaterialIcons"
                            TextColor="White"
                            VerticalOptions="Center"
                            Text="{Binding PasswordIconCode}" />
                </Grid>
            </Border>

            <!-- כפתור התחברות Submit -->
            <Button CornerRadius="8"
                    FontSize="18"
                    HeightRequest="50"
                    IsEnabled="{Binding IsSignInButtonEnabled}"
                    Text="SignIn"
                    TextColor="White"
                    Clicked="OnSignInButtonClick" />

            <!-- הודעת שגיאה / התחברות -->
            <Label x:Name="messageLabel"
                   FontSize="45"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding SignInMessageVisible}"
                   Text="{Binding LoginMessage}"
                   TextColor="{Binding SignInMessageColor}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
